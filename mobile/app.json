{
    "expo": {
        "name": "ASGL Vận Tải",
        "slug": "asgt",
        "version": "1.0.0",
        "orientation": "portrait",
        "icon": "./assets/icon.png",
        "userInterfaceStyle": "light",
        "scheme": "tms-driver",
        "plugins": [
            "./plugins/withAndroidManifest.mjs",
            "expo-router",
            "expo-image-picker",
            [
                "expo-location",
                {
                    "locationAlwaysAndWhenInUsePermission": "Cần GPS để ghi nhận vị trí chốt chặng"
                }
            ],
            "expo-status-bar",
            "expo-font",
            [
                "expo-notifications",
                {
                    "icon": "./assets/android-icon-monochrome.png",
                    "color": "#4F46E5",
                    "sounds": []
                }
            ]
        ],
        "ios": {
            "supportsTablet": true,
            "bundleIdentifier": "vn.asgt.tmsdriver",
            "googleServicesFile": "./GoogleService-Info.plist",
            "entitlements": {
                "aps-environment": "production"
            },
            "infoPlist": {
                "NSCameraUsageDescription": "Ứng dụng cần sử dụng camera để tài xế chụp ảnh hàng hóa và biên bản giao nhận tại các chốt kiểm tra.",
                "NSPhotoLibraryUsageDescription": "Ứng dụng cần truy cập thư viện ảnh để tài xế tải lên hình ảnh biên bản giao nhận và chứng từ vận chuyển.",
                "NSLocationWhenInUseUsageDescription": "Ứng dụng cần truy cập vị trí khi sử dụng để xác thực vị trí tài xế tại điểm lấy hàng, giao hàng và ghi nhận lộ trình chuyến đi.",
                "UIDesignRequiresCompatibility": true,
                "NSAppTransportSecurity": {
                    "NSAllowsArbitraryLoads": true,
                    "NSAllowsLocalNetworking": true
                },
                "ITSAppUsesNonExemptEncryption": false
            }
        },
        "android": {
            "googleServicesFile": "./google-services.json",
            "usesCleartextTraffic": true,
            "adaptiveIcon": {
                "backgroundColor": "#FFFFFF",
                "foregroundImage": "./assets/android-icon-foreground.png",
                "backgroundImage": "./assets/android-icon-background.png",
                "monochromeImage": "./assets/android-icon-monochrome.png"
            },
            "predictiveBackGestureEnabled": false,
            "permissions": [
                "android.permission.ACCESS_COARSE_LOCATION",
                "android.permission.ACCESS_FINE_LOCATION",
                "android.permission.POST_NOTIFICATIONS"
            ],
            "package": "vn.asgt.tmsdriver"
        },
        "web": {
            "favicon": "./assets/favicon.png"
        },
        "extra": {
            "router": {},
            "eas": {
                "projectId": "4a73c5d5-0135-4373-a36e-8e0b2009c779"
            }
        }
    }
}
