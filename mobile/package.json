{
    "name": "tms-mobile",
    "version": "1.0.0",
    "main": "expo-router/entry",
    "dependencies": {
        "@expo/metro-runtime": "~4.0.1",
        "@expo/vector-icons": "~14.0.4",
        "@react-native-async-storage/async-storage": "1.23.1",
        "expo": "^52.0.0",
        "expo-constants": "~17.0.8",
        "expo-dev-client": "~5.0.20",
        "expo-device": "~7.0.3",
        "expo-font": "~13.0.4",
        "expo-image-picker": "~16.0.6",
        "expo-linking": "~7.0.5",
        "expo-location": "~18.0.10",
        "expo-notifications": "~0.29.14",
        "expo-router": "~4.0.22",
        "expo-sqlite": "~15.1.4",
        "expo-status-bar": "~2.0.1",
        "expo-task-manager": "~12.0.6",
        "leaflet": "^1.9.4",
        "query-string": "^7.1.3",
        "react": "18.3.1",
        "react-dom": "18.3.1",
        "react-native": "0.76.9",
        "react-native-safe-area-context": "4.12.0",
        "react-native-screens": "~4.4.0",
        "react-native-web": "~0.19.13"
    },
    "devDependencies": {
        "@types/leaflet": "^1.9.21",
        "@types/react": "~18.3.12",
        "typescript": "^5.3.3"
    },
    "scripts": {
        "start": "expo start",
        "start:dev": "expo start --dev-client",
        "android": "expo run:android",
        "ios": "expo run:ios",
        "web": "expo start --web",
        "postinstall": "node -e \"var fs=require('fs');['node_modules/expo-router/build/fork/getPathFromState.js','node_modules/expo-router/build/fork/getPathFromState-forks.js','node_modules/expo-router/build/fork/getStateFromPath-forks.js'].forEach(f=>{try{var c=fs.readFileSync(f,'utf8');c=c.replace(/baseUrl = process\\.env\\.EXPO_BASE_URL/g,\\\"baseUrl = '/mobile'\\\");fs.writeFileSync(f,c)}catch(e){}})\"",
        "build:web": "rm -rf ../public/mobile && npx expo export --platform web --output-dir ../public/mobile && sed -i.bak 's|href=\"/favicon.ico\"|href=\"/mobile/favicon.ico\"|' ../public/mobile/index.html && rm -f ../public/mobile/index.html.bak && sed -i.bak 's|href=\"/_expo/|href=\"/mobile/_expo/|g' ../public/mobile/index.html && rm -f ../public/mobile/index.html.bak && sed -i.bak 's|src=\"/_expo/|src=\"/mobile/_expo/|' ../public/mobile/index.html && rm -f ../public/mobile/index.html.bak && sed -i.bak 's|\"/assets/|\"/mobile/assets/|g' ../public/mobile/_expo/static/js/web/entry-*.js && rm -f ../public/mobile/_expo/static/js/web/entry-*.js.bak",
        "build:android:apk": "npx eas-cli build --platform android --profile preview",
        "build:prod": "npx eas-cli build --profile production",
        "build:prod:android": "npx eas-cli build --platform android --profile production",
        "build:prod:ios": "npx eas-cli build --platform ios --profile production"
    },
    "private": true
}